<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AntiLazy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <!-- 全屏提醒页：半透明浮层，居中卡片 -->
    <style name="Theme.Reminder" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
